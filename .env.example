# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5434
PG_DATABASE=sales_dw
PG_USER=etl_user
PG_PASSWORD=change_me

# ---------- AWS / S3 ----------
# Use the access keys of the dedicated least-privilege IAM user (see iam/ and README).
# Never commit real values: copy this file to .env, which is git-ignored.
S3_ENABLED=true
S3_BUCKET=your-bucket-name
S3_PREFIX=sales-etl
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Pipeline ----------
LOG_LEVEL=INFO
