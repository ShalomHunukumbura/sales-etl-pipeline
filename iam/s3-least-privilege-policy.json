{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyThePipelinePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME",
      "Condition": {
        "StringLike": { "s3:prefix": ["sales-etl/*"] }
      }
    },
    {
      "Sid": "ReadWriteObjectsUnderPipelinePrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/sales-etl/*"
    }
  ]
}
